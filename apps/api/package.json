{
  "name": "@optica/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @optica/contracts build",
    "dev": "tsx watch src/app.ts",
    "prebuild": "pnpm --filter @optica/contracts build",
    "build": "tsc",
    "pretypecheck": "pnpm --filter @optica/contracts build",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-winston": "^4.2.0",
    "pg": "^8.23.0",
    "@optica/contracts": "workspace:*",
    "winston": "^3.19.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
