# PostgreSQL initial credentials. Use a long unique password and URL-encode it in DATABASE_URL.
POSTGRES_DB=optica
POSTGRES_USER=optica
POSTGRES_PASSWORD=replace-with-a-long-unique-password

# Docker Compose resolves "db" to the PostgreSQL service, not localhost.
DATABASE_URL=postgresql://optica:replace-with-a-long-unique-password@db:5432/optica

NODE_ENV=prod
PORT=3000
HOST=0.0.0.0
