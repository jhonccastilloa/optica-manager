# ================================================================
# BASE DE DATOS
# ================================================================
# Credenciales iniciales de PostgreSQL. Usa una contraseña larga y única.
POSTGRES_DB=optica
POSTGRES_USER=optica
POSTGRES_PASSWORD=replace-with-a-long-unique-password

# Docker Compose resuelve "db" al contenedor de PostgreSQL y sustituye estas
# variables automáticamente. Para mantener esta composición automática, usa
# una contraseña segura para URL. Si contiene @, #, /, ?, %, etc., reemplaza
# DATABASE_URL manualmente usando la contraseña codificada para URL.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ================================================================
# PUBLICACIÓN DE SERVICIOS
# ================================================================
# Puerto del frontend publicado por Docker en el servidor.
# Nginx continúa escuchando internamente en el puerto 80.
FRONTEND_PUBLISHED_PORT=4444

# Puerto del API publicado por Docker en el servidor.
# Debe coincidir con el puerto usado en VITE_API_URL.
API_PUBLISHED_PORT=3000

# ================================================================
# API
# ================================================================
NODE_ENV=prod
PORT=3000
HOST=0.0.0.0

# ================================================================
# CONEXIÓN FRONTEND ↔ API
# ================================================================
# Por defecto se construye usando el puerto publicado del frontend.
# Si el frontend está en otro servidor o dominio, reemplaza este valor por
# su URL pública completa, sin una barra final.
CORS_ORIGIN=http://localhost:${FRONTEND_PUBLISHED_PORT}

# Por defecto se construye usando el puerto publicado del API.
# El navegador debe poder acceder a esta URL; no uses http://api:3000.
# Si el API está en otro servidor o dominio, reemplaza este valor por su URL
# pública completa. No agregues /api: la aplicación lo añade automáticamente.
VITE_API_URL=http://localhost:${API_PUBLISHED_PORT}
